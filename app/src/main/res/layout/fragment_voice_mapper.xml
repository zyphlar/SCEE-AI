<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Main content container - bottom-centered.
         marginStart leaves space for the edit-history/undo button on the left.
         marginEnd leaves space for the follow-position / zoom buttons on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="60dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Transcription / status card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/transcriptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="12sp"
                    tools:text="Listening..." />

                <TextView
                    android:id="@+id/transcriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="McDonald's on the left, KFC on the right" />

                <ProgressBar
                    android:id="@+id/processingIndicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Pending edits container — hidden by default, toggled by badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/pendingEditsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/pendingEditsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="3 pending" />

                    <Button
                        android:id="@+id/exportEditsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#FF8800"
                        android:text="Export"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/confirmAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/primary"
                        android:text="Save All"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/cancelAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="@android:color/darker_gray"
                        android:text="Cancel"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pendingEditsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxHeight="200dp"
                    android:nestedScrollingEnabled="true"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_pending_edit" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Help + command log panel — toggled by the help button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/commandLogCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Help reference text -->
                <TextView
                    android:id="@+id/helpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Divider — only visible when there are log entries -->
                <View
                    android:id="@+id/helpLogDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@android:color/darker_gray"
                    android:visibility="gone" />

                <!-- Recent command log -->
                <TextView
                    android:id="@+id/commandLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="8"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="✓ Starbucks on the left → 1 edit pending&#10;✗ the bakery is now a restaurant → no match"
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 3-column button row: [edit+settings] [mic] [pending+help] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Column 1: Text-input toggle (pencil) + Settings -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">
                    <ImageButton
                        android:id="@+id/textInputToggleButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Type command"
                        android:src="@drawable/ic_edit"
                        android:tint="@android:color/darker_gray" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">
                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings"
                        android:src="@drawable/ic_settings"
                        android:tint="@android:color/darker_gray" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Column 2: Main voice button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp">

                <ImageButton
                    android:id="@+id/voiceButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_voice_button"
                    android:contentDescription="Start voice mapping"
                    android:elevation="8dp"
                    android:src="@drawable/ic_mic" />

                <!-- Continuous mode indicator dot -->
                <View
                    android:id="@+id/continuousModeIndicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_continuous_indicator"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

            <!-- Column 3: Pending badge + Help -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Pending count badge — invisible when no edits, keeps stable layout -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/pendingCountCard"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="invisible"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    tools:visibility="visible">
                    <TextView
                        android:id="@+id/pendingCountBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/primary"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </androidx.cardview.widget.CardView>

                <!-- Help button — toggles command log; long-press for help text -->
                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">
                    <ImageButton
                        android:id="@+id/helpButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Help / command log"
                        android:src="@drawable/ic_help"
                        android:tint="@android:color/darker_gray" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Text input row — hidden by default, toggled by pencil button -->
        <LinearLayout
            android:id="@+id/textInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/textCommandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type a command…"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:padding="8dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/submitTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Send"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Hint text -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Tap · Long-press for continuous"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
